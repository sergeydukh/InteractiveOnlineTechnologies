{
  "name": "qa-automation-playwright",
  "version": "1.0.0",
  "description": "QA Automation test suite for mediamarslab recruitment app",
  "scripts": {
    "test": "playwright test --project=api --project=smoke --project=ui --project=integration --grep-invert @known-defect",
    "test:cross-browser-smoke": "playwright test --project=smoke --project=smoke-firefox --project=smoke-webkit --grep-invert @known-defect",
    "test:smoke": "playwright test --project=smoke --grep-invert @known-defect",
    "test:ui": "playwright test --project=ui --grep-invert @known-defect",
    "test:api": "playwright test --project=api --grep-invert @known-defect",
    "test:integration": "playwright test --project=integration --grep-invert @known-defect",
    "test:known-defects": "playwright test --project=api --project=ui --grep @known-defect",
    "test:headed": "playwright test --headed",
    "test:ui-mode": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:list": "playwright test --list --reporter=line",
    "artifacts:scan": "node scripts/scan-artifacts.cjs playwright-report test-results",
    "unit": "vitest run",
    "unit:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run unit:coverage && npm run test:list",
    "secrets:bootstrap": "node scripts/create-env-from-application.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.38.0",
    "eslint-plugin-playwright": "^2.11.0",
    "globals": "^17.10.0",
    "prettier": "^3.7.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  }
}
