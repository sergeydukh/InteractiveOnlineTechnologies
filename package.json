{
  "name": "qa-automation-playwright",
  "version": "1.0.0",
  "description": "QA Automation test suite for mediamarslab recruitment app",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --project=smoke",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:integration": "playwright test --project=integration",
    "test:headed": "playwright test --headed",
    "test:ui-mode": "playwright test --ui",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "secrets:bootstrap": "node scripts/create-env-from-application.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
